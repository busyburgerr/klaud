# Пример окружения для продакшена.
# Скопируйте в .env рядом с package.json и заполните: cp .env.example .env
# Файл .env в репозиторий не попадает (см. .gitignore).

# ── Обязательно ───────────────────────────────────────────────────────────
# Секрет для подписи JWT, не короче 32 символов. Без него прод не стартует.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=69bede528dcdff804905fb422750b7202613b8a822068ce8ce25e109c7b2a45af7c2733d962c242d8c2eae4347e5a3b8

# Подключение к Postgres. Пароль обязателен в проде — свой, не из примера.
DATABASE_URL=postgres://cloud:cloud@127.0.0.1:5432/cloud

# ── Режим и адрес ─────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=3001
# За nginx наружу слушать не нужно — только петля.
API_HOST=127.0.0.1

# ── Данные ────────────────────────────────────────────────────────────────
# Фотографии лотов лежат на диске рядом с кодом.
# UPLOADS_DIR=/srv/cloud/server/uploads

# Демо-каталог при пустой базе не создаём: наполняем её сами (api:reset).
SEED=off

# ── Коды подтверждения по СМС ─────────────────────────────────────────────
# off   — подтверждение выключено: вход и регистрация только по паролю (так
#         работает прод по умолчанию, пока не подключён провайдер);
# smsru — настоящая отправка через sms.ru, нужен ключ ниже;
# log   — код пишется в журнал сервера (для разработки).
# SMS_PROVIDER=smsru
# SMS_API_KEY=
# Имя отправителя, если оно согласовано с оператором.
# SMS_SENDER=
# Срок жизни кода и пауза между отправками, в секундах.
# SMS_CODE_TTL=300
# SMS_RESEND=60
# Сколько неверных попыток гасят код.
# SMS_ATTEMPTS=5

# ── Вход через соцсети ────────────────────────────────────────────────────
# Кнопка появляется, только когда заполнены оба ключа приложения и PUBLIC_URL:
# на него провайдер вернёт человека после согласия.
# PUBLIC_URL=https://klaud.pro
# ВКонтакте — приложение в VK ID (dev.vk.com), тип «Сайт».
# В доверенные redirect URL добавьте оба адреса:
#   https://klaud.pro                              — для виджета VK ID
#   https://klaud.pro/api/auth/oauth/vk/callback   — для запасного потока
# OAUTH_VK_CLIENT_ID=
# OAUTH_VK_SECRET=
# Доступы приложения; пусто — только базовый профиль.
# OAUTH_VK_SCOPE=email
# Mail.ru — приложение на oauth.mail.ru.
# OAUTH_MAILRU_CLIENT_ID=
# OAUTH_MAILRU_SECRET=

# ── Необязательное ────────────────────────────────────────────────────────
# Схема внутри базы: тесты используют свои, приложению хватает public.
# DB_SCHEMA=public
# Размер пула соединений.
# DB_POOL_MAX=10
# Срок жизни токена входа.
# JWT_TTL=30d
# Раздачу собранного dist/ тем же процессом можно выключить, если статику
# отдаёт nginx напрямую.
# SERVE_CLIENT=off
# Домены, которым разрешены запросы с cookie, если API живёт на другом домене.
# CORS_ORIGINS=https://klaud.ru
# Отключить встроенный лимитер запросов (не рекомендуется).
# RATE_LIMIT=off

# ── Разработка ────────────────────────────────────────────────────────────
# С docker compose up -d подойдут значения по умолчанию:
# DATABASE_URL=postgres://cloud:cloud@127.0.0.1:5432/cloud
# Тесты берут отдельную базу; переопределяется через TEST_DATABASE_URL.
# TEST_DATABASE_URL=postgres://cloud:cloud@127.0.0.1:5432/cloud_test
