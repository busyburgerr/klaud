# Пример окружения для продакшена.
# Скопируйте в .env рядом с package.json и заполните: cp .env.example .env
# Файл .env в репозиторий не попадает (см. .gitignore).

# ── Обязательно ───────────────────────────────────────────────────────────
# Секрет для подписи JWT, не короче 32 символов. Без него прод не стартует.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Подключение к Postgres. Пароль обязателен в проде — свой, не из примера.
DATABASE_URL=postgres://cloud:cloud@127.0.0.1:5432/cloud

# ── Режим и адрес ─────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=3001
# За nginx наружу слушать не нужно — только петля.
API_HOST=127.0.0.1

# ── Данные ────────────────────────────────────────────────────────────────
# Фотографии лотов лежат на диске рядом с кодом.
# UPLOADS_DIR=/srv/cloud/server/uploads

# Демо-каталог при пустой базе не создаём: наполняем её сами (api:reset).
SEED=off

# ── Необязательное ────────────────────────────────────────────────────────
# Схема внутри базы: тесты используют свои, приложению хватает public.
# DB_SCHEMA=public
# Размер пула соединений.
# DB_POOL_MAX=10
# Срок жизни токена входа.
# JWT_TTL=30d
# Раздачу собранного dist/ тем же процессом можно выключить, если статику
# отдаёт nginx напрямую.
# SERVE_CLIENT=off
# Домены, которым разрешены запросы с cookie, если API живёт на другом домене.
# CORS_ORIGINS=https://klaud.ru
# Отключить встроенный лимитер запросов (не рекомендуется).
# RATE_LIMIT=off

# ── Разработка ────────────────────────────────────────────────────────────
# С docker compose up -d подойдут значения по умолчанию:
# DATABASE_URL=postgres://cloud:cloud@127.0.0.1:5432/cloud
# Тесты берут отдельную базу; переопределяется через TEST_DATABASE_URL.
# TEST_DATABASE_URL=postgres://cloud:cloud@127.0.0.1:5432/cloud_test
